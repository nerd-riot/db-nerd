{
  "name": "dbnerd",
  "private": true,
  "version": "1.2.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:beta": "node scripts/set-channel.js beta && pnpm dev",
    "dev:release": "node scripts/set-channel.js release && pnpm dev",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:all": "node --test tests/*.test.ts && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "build": "tsc && vite build",
    "build:app": "node scripts/build-dist.js --all",
    "build:app:mac": "node scripts/build-dist.js --mac",
    "build:app:win": "node scripts/build-dist.js --win",
    "build:app:downloads": "node scripts/build-dist.js --all --downloads",
    "build:beta": "node scripts/set-channel.js beta && pnpm build && pnpm tauri build",
    "build:release": "node scripts/set-channel.js release && pnpm build && pnpm tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:beta": "node scripts/set-channel.js beta && tauri dev",
    "tauri:dev:release": "node scripts/set-channel.js release && tauri dev",
    "channel:status": "node scripts/set-channel.js status",
    "channel:beta": "node scripts/set-channel.js beta",
    "channel:release": "node scripts/set-channel.js release",
    "channel:toggle": "node scripts/set-channel.js toggle",
    "update-readme": "node scripts/capture_readme_screenshots.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/lodash-es": "^4.17.12",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
